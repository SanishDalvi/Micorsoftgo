# ==============================================================================
# MLSA Gamified Learning Platform & Secret Vault - Environment Variables
# ==============================================================================

# --- APPLICATION SETTINGS ---
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Coordinator Admin Passcode
ADMIN_PASSCODE=zxcvbnm,./

# --- SUPABASE DATABASE CONFIGURATION (OPTIONAL / PRODUCTION) ---
# Create a project on https://supabase.com and run supabase_schema.sql in the SQL Editor
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Client-exposed Supabase keys
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- IMAGEKIT MEDIA CDN CONFIGURATION (OPTIONAL / PRODUCTION) ---
# Create an account at https://imagekit.io
# Upload your guide screenshots (e.g., guide/step1-ms-learn-profile.png)
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key

# --- EMAIL NOTIFICATIONS / SMTP (OPTIONAL) ---
# Used for temporary password reset emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="MLSA Chapter Community <no-reply@campus.edu>"

# --- GEMINI AI INTEGRATION (OPTIONAL) ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
